# TaskFlow production environment. Copy to .env on the server and fill in.
# Never commit the real .env.

# --- Image ------------------------------------------------------------------
IMAGE=ghcr.io/kot-enterprises/taskflow-backend
IMAGE_TAG=latest
HTTP_PORT=8080

# --- Django -----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=taskflow-api.kotenterprises.dev
CSRF_TRUSTED_ORIGINS=https://taskflow-api.kotenterprises.dev
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=
# Raise to 31536000 after HTTPS has worked for a few days.
SECURE_HSTS_SECONDS=3600
LOG_LEVEL=INFO

# --- Gunicorn ---------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# --- Database (used by both Postgres and Django) ------------------------------
DB_NAME=taskflow
DB_USER=taskflow
# Generate: openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=change-me
DB_CONN_MAX_AGE=60

# --- Backups ----------------------------------------------------------------
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=1

# --- E-mail -----------------------------------------------------------------
EMAIL_HOST=mail.kotenterprises.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TaskFlow <no-reply@kotenterprises.com>

# --- AI assistant -----------------------------------------------------------
GEMINI_API_KEY=
